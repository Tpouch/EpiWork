# Copy to the repository root as .env and fill in the values.

# SQLite database file, relative to backend/prisma.config.js.
DATABASE_URL="file:./prisma/dev.db"

# Initial password of the default admin (admin@devgoblin.fr).
# Used only when that account has no password yet: changing it later
# from "My account" wins over this value.
ADMIN_PASSWORD=change-me-please

# Optional: API port (defaults to 4000).
# PORT=4000

# Secret of the flag checker (workshops with a slug). Keep it private and
# never change it once students received their codes: it would invalidate
# every identification code, pairing code and flag.
WORKSHOP_SECRET=change-me-with-a-long-random-string

# Public address of the API, with /api: students put it in EPIWORK_URL when
# they run the check script. Shown on the workshop setup page.
# PUBLIC_API_URL=https://epiwork.example.com/api
