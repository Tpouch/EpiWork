generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String?         @unique
  role           String
  passwordHash   String?
  accentColor    String?
  sessions       Session[]
  stepProgress   StepProgress[]
  participations Participation[]
  sessionEvents  SessionEvent[]
  feedback       Feedback[]
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Workshop {
  id             Int             @id @default(autoincrement())
  title          String
  description    String
  icon           String          @default("📘")
  isActive       Boolean         @default(false)
  joinCode       String?
  launchedAt     DateTime?
  steps          Step[]
  sections       Section[]
  docPages       DocPage[]
  participations Participation[]
  sessionEvents  SessionEvent[]
  runs           WorkshopRun[]
}

model Participation {
  id         Int      @id @default(autoincrement())
  studentId  Int
  student    User     @relation(fields: [studentId], references: [id])
  workshopId Int
  workshop   Workshop @relation(fields: [workshopId], references: [id])
  joinedAt   DateTime @default(now())

  @@unique([studentId, workshopId])
}

model Section {
  id         Int      @id @default(autoincrement())
  workshopId Int
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  order      Int
  title      String
  steps      Step[]
}

model Step {
  id               Int            @id @default(autoincrement())
  workshopId       Int
  workshop         Workshop       @relation(fields: [workshopId], references: [id])
  sectionId        Int?
  section          Section?       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order            Int
  title            String
  content          String
  hint             String?
  solution         String?
  questionType     String?
  questionPrompt   String?
  questionOptions  String?
  questionAnswer   String?
  questionFeedback String?
  progress         StepProgress[]
  sessionEvents    SessionEvent[]
}

model StepProgress {
  id               Int      @id @default(autoincrement())
  studentId        Int
  student          User     @relation(fields: [studentId], references: [id])
  stepId           Int
  step             Step     @relation(fields: [stepId], references: [id])
  status           String   @default("locked")
  submittedAnswer  String?
  helpRequested    Boolean  @default(false)
  solutionUnlocked Boolean  @default(false)
  failedAttempts   Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([studentId, stepId])
}

model DocPage {
  id         Int      @id @default(autoincrement())
  workshopId Int
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  order      Int
  title      String
  content    String
}

model SessionEvent {
  id         Int      @id @default(autoincrement())
  workshopId Int
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  studentId  Int
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stepId     Int?
  step       Step?    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  type       String
  answer     String?
  createdAt  DateTime @default(now())
}

model WorkshopRun {
  id         Int        @id @default(autoincrement())
  workshopId Int
  workshop   Workshop   @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  launchedAt DateTime
  endedAt    DateTime?
  feedback   Feedback[]
}

model Feedback {
  id        Int         @id @default(autoincrement())
  runId     Int
  run       WorkshopRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  studentId Int
  student   User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime

  @@unique([runId, studentId])
}
